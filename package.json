{
  "name": "clew",
  "productName": "Clew",
  "version": "0.9.0",
  "description": "An open-source, Obsidian-style note-taking app built on the jmarkdown engine.",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "author": "J. McKenzie Alexander",
  "homepage": "https://jmckalex.org",
  "desktopName": "clew.desktop",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "node scripts/vendor-jmarkdown.js && node scripts/vendor-embedpdf.js && node scripts/dev.js",
    "build": "node scripts/build.js",
    "start": "node scripts/build.js && electron .",
    "test": "node --test",
    "sync-engine": "node scripts/vendor-jmarkdown.js",
    "sync-embedpdf": "node scripts/vendor-embedpdf.js",
    "sync-mptikz": "node scripts/stage-mptikz.js",
    "package": "node scripts/package.js",
    "package:dmg": "node scripts/package.js --dmg",
    "package:dist": "node scripts/package.js --dmg --sign --notarize",
    "package:win": "node scripts/package.js --win",
    "package:linux": "node scripts/package.js --linux",
    "vault-report": "node scripts/vault-report.js",
    "dataview-report": "node scripts/dataview-report.js",
    "notices": "node scripts/gen-notices.js"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "@awesome.me/webawesome": "^3.12.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@embedpdf/models": "^2.15.0",
    "@embedpdf/pdfium": "^2.15.0",
    "@excalidraw/excalidraw": "^0.18.1",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.7.2",
    "chart.js": "^4.5.1",
    "chokidar": "^5.0.0",
    "d3-force": "^3.0.0",
    "highlight.js": "^11.12.0",
    "jmarkdown": "file:vendor/jmarkdown",
    "jquery": "^4.0.0",
    "leaflet": "^1.9.4",
    "lz-string": "^1.5.0",
    "mathjax": "^3.2.2",
    "mermaid": "^11.17.0",
    "morphdom": "^2.7.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "build": {
    "appId": "org.jmckalex.clew",
    "productName": "Clew",
    "asar": true,
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "package.json",
      "!node_modules/**/*"
    ],
    "directories": {
      "output": "out",
      "buildResources": "build-resources"
    },
    "extraResources": [
      {
        "from": "THIRD-PARTY-NOTICES.md",
        "to": "THIRD-PARTY-NOTICES.md"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "build-engine/jmarkdown",
        "to": "engine/jmarkdown"
      },
      {
        "from": "dist/engine",
        "to": "engine-assets"
      },
      {
        "from": "node_modules/mathjax/es5",
        "to": "preview-assets/mathjax/es5"
      },
      {
        "from": "node_modules/mermaid/dist",
        "to": "preview-assets/mermaid/dist",
        "filter": [
          "mermaid.min.js"
        ]
      },
      {
        "from": "node_modules/highlight.js/styles",
        "to": "preview-assets/highlight.js/styles"
      },
      {
        "from": "node_modules/@fortawesome/fontawesome-free/js",
        "to": "preview-assets/@fortawesome/fontawesome-free/js"
      },
      {
        "from": "node_modules/jquery/dist",
        "to": "preview-assets/jquery/dist"
      },
      {
        "from": "node_modules/leaflet/dist",
        "to": "preview-assets/leaflet/dist"
      },
      {
        "from": "vendor/embedpdf/dist",
        "to": "preview-assets/embedpdf"
      },
      {
        "from": "mptikz-assets",
        "to": "mptikz",
        "filter": [
          "**/*",
          "!.cache/**",
          "!**/*.js.map",
          "!**/.DS_Store"
        ]
      },
      {
        "from": "node_modules/@excalidraw/excalidraw/dist/prod",
        "to": "preview-assets/@excalidraw/excalidraw/dist/prod",
        "filter": [
          "fonts/**/*",
          "data/**/*"
        ]
      },
      {
        "from": "demo-vault",
        "to": "demo-vault",
        "filter": [
          "**/*",
          "!.clew/**",
          "!**/.DS_Store"
        ]
      },
      {
        "from": "demo-vault/.clew/vault-settings.json",
        "to": "demo-vault/.clew/vault-settings.json"
      },
      {
        "from": "demo-vault/.clew/plugins",
        "to": "demo-vault/.clew/plugins",
        "filter": [
          "**/*",
          "!**/.DS_Store"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build-resources/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build-resources/entitlements.mac.plist",
      "entitlementsInherit": "build-resources/entitlements.mac.inherit.plist",
      "extendInfo": {
        "NSDocumentsFolderUsageDescription": "Clew needs access to your Documents folder to open vaults stored there.",
        "NSDesktopFolderUsageDescription": "Clew needs access to your Desktop to open vaults stored there.",
        "NSDownloadsFolderUsageDescription": "Clew needs access to your Downloads folder to open vaults stored there.",
        "NSRemovableVolumesUsageDescription": "Clew needs access to removable volumes to open vaults stored on them.",
        "NSNetworkVolumesUsageDescription": "Clew needs access to network volumes to open vaults stored on them.",
        "NSHumanReadableCopyright": "Copyright © J. McKenzie Alexander. GPL-3.0-or-later."
      },
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "Clew"
    },
    "win": {
      "icon": "build-resources/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "icon": "build-resources/icon.png",
      "category": "Office",
      "maintainer": "J. McKenzie Alexander <jmckalex@gmail.com>",
      "syncDesktopName": true,
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "afterPack": "scripts/after-pack.cjs"
  }
}
