{
  "name": "clew",
  "productName": "Clew",
  "version": "0.7.0",
  "description": "An open-source, Obsidian-style note-taking app built on the jmarkdown engine.",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "author": "J. McKenzie Alexander",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "node scripts/vendor-jmarkdown.js && node scripts/dev.js",
    "build": "node scripts/build.js",
    "start": "node scripts/build.js && electron .",
    "test": "node --test",
    "sync-engine": "node scripts/vendor-jmarkdown.js",
    "package": "node scripts/package.js",
    "package:dmg": "node scripts/package.js --dmg"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.7.2",
    "chokidar": "^5.0.0",
    "d3-force": "^3.0.0",
    "highlight.js": "^11.12.0",
    "jmarkdown": "file:vendor/jmarkdown",
    "jquery": "^4.0.0",
    "mathjax": "^3.2.2",
    "mermaid": "^11.17.0",
    "morphdom": "^2.7.8"
  },
  "build": {
    "appId": "org.jmckalex.clew",
    "productName": "Clew",
    "asar": true,
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "package.json",
      "!node_modules/**/*"
    ],
    "directories": {
      "output": "out",
      "buildResources": "build-resources"
    },
    "extraResources": [
      {
        "from": "build-engine/jmarkdown",
        "to": "engine/jmarkdown"
      },
      {
        "from": "dist/engine",
        "to": "engine-assets"
      },
      {
        "from": "node_modules/mathjax/es5",
        "to": "preview-assets/mathjax/es5"
      },
      {
        "from": "node_modules/mermaid/dist",
        "to": "preview-assets/mermaid/dist",
        "filter": [
          "mermaid.min.js"
        ]
      },
      {
        "from": "node_modules/highlight.js/styles",
        "to": "preview-assets/highlight.js/styles"
      },
      {
        "from": "node_modules/@fortawesome/fontawesome-free/js",
        "to": "preview-assets/@fortawesome/fontawesome-free/js"
      },
      {
        "from": "node_modules/jquery/dist",
        "to": "preview-assets/jquery/dist"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build-resources/icon.icns",
      "identity": null,
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "Clew"
    },
    "afterPack": "scripts/after-pack.cjs"
  }
}
